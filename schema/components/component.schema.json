{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/plexusone/systemspec-designsystem/sdk/go/component",
  "$ref": "#/$defs/Component",
  "$defs": {
    "Component": {
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "variants": {
          "items": {
            "$ref": "#/$defs/Variant"
          },
          "type": "array"
        },
        "states": {
          "items": {
            "$ref": "#/$defs/State"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/Prop"
          },
          "type": "array"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/ComponentEvent"
          },
          "type": "array"
        },
        "slots": {
          "items": {
            "$ref": "#/$defs/Slot"
          },
          "type": "array"
        },
        "uses": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "tokensUsed": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "constraints": {
          "$ref": "#/$defs/Constraints"
        },
        "themingContract": {
          "$ref": "#/$defs/ThemingContract"
        },
        "accessibility": {
          "$ref": "#/$defs/ComponentA11y"
        },
        "llm": {
          "$ref": "#/$defs/LLMContext"
        },
        "documentationUrl": {
          "type": "string",
          "format": "uri"
        },
        "figmaUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ComponentA11y": {
      "properties": {
        "ariaPattern": {
          "type": "string",
          "description": "WAI-ARIA Authoring Practices pattern name. References https://www.w3.org/WAI/ARIA/apg/patterns/{pattern}/. Examples: dialog, tabs, combobox, menu-button, accordion, disclosure, listbox, tree-view, carousel, feed."
        },
        "role": {
          "type": "string"
        },
        "requiredAttributes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "keyboardSupport": {
          "items": {
            "$ref": "#/$defs/KeyboardInteraction"
          },
          "type": "array"
        },
        "screenReaderNotes": {
          "type": "string"
        },
        "focusManagement": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ComponentEvent": {
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "bubbles": {
          "type": "boolean"
        },
        "detail": {
          "items": {
            "$ref": "#/$defs/EventDetailField"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Constraints": {
      "properties": {
        "minWidth": {
          "type": "string"
        },
        "maxWidth": {
          "type": "string"
        },
        "maxChildren": {
          "type": "integer"
        },
        "requiredParent": {
          "type": "string"
        },
        "forbiddenChildren": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "responsiveBehavior": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "EventDetailField": {
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "KeyboardInteraction": {
      "properties": {
        "key": {
          "type": "string"
        },
        "action": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "LLMContext": {
      "properties": {
        "intent": {
          "type": "string"
        },
        "allowedContexts": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "forbiddenContexts": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "dependencies": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "exampleUsage": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "antiPatterns": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "semanticMeaning": {
          "type": "string"
        },
        "relatedElements": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "priorityScore": {
          "type": "integer",
          "maximum": 100,
          "minimum": 1
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Prop": {
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "default": true,
        "enumValues": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "constraints": {
          "$ref": "#/$defs/PropConstraints"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "PropConstraints": {
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "pattern": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Slot": {
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "allowedComponents": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "State": {
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "tokenOverrides": {
          "items": {
            "$ref": "#/$defs/TokenOverride"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ThemeToken": {
      "properties": {
        "id": {
          "type": "string"
        },
        "cssProperty": {
          "type": "string"
        },
        "semantic": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "defaultLight": {
          "type": "string"
        },
        "defaultDark": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ThemingContract": {
      "properties": {
        "prefix": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "tokens": {
          "items": {
            "$ref": "#/$defs/ThemeToken"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "TokenOverride": {
      "properties": {
        "tokenId": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Variant": {
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "isDefault": {
          "type": "boolean"
        },
        "tokenOverrides": {
          "items": {
            "$ref": "#/$defs/TokenOverride"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  }
}